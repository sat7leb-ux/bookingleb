# ---- Supabase (REQUIRED for the app to function) ----
# Project URL — found in Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key — safe to expose (RLS enforces access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY. Never commit to the client bundle.
# Needed for Server Action writes. If omitted, writes fall back to the RLS
# cookie client (per-user scope) so the app still works for logged-in users.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Seed script only (scripts/seed.ts) ----
# Personal access token from https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Your project ref (the xxx in https://xxx.supabase.co)
SUPABASE_PROJECT_REF=
