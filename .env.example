# ---- Neon Postgres (REQUIRED) ----
# Get this from https://console.neon.tech → your project → Connection Details → Pooled connection string.
# Free tier, no per-org project cap like Supabase.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ---- Auth.js (session signing) ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# ---- Seed bootstrap (optional) ----
# Used only by `npm run seed` to create the first Administrator account.
BOOTSTRAP_ADMIN_EMAIL=admin@bookingleb.app
BOOTSTRAP_ADMIN_PASSWORD=Admin1234!
